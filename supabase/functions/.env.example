# Optional Edge Function settings. For local dev copy to supabase/functions/.env
# (git-ignored). For production use `supabase secrets set KEY=value`.
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected by
# the platform automatically; do NOT define them here.
ALLOWED_ORIGINS=http://localhost:5173
MAX_UPLOAD_BYTES=5242880
